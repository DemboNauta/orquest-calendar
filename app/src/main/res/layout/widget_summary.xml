        <TextView android:id="@+id/w_hours1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_pill" android:paddingLeft="9dp" android:paddingRight="9dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textColor="#00351F" android:textStyle="bold" android:textSize="12sp" android:text="" />
